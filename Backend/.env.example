# Configuración de ejemplo para TallerClaro backend.
# Copia este archivo como .env y reemplaza los valores ficticios por los reales.
# Nunca subas .env con secretos a Git.

TALLERCLARO_APP_NAME=TallerClaro API

# Entorno de ejecución: development | test | release.
# En `release` se rechazan secretos de plantilla, CORS con comodines,
# orígenes/URL públicas sin HTTPS, PayPal incompleto y Live sin habilitación.
TALLERCLARO_ENVIRONMENT=development

# Base de datos PostgreSQL / Supabase (valores ficticios).
# URL recomendada (Supabase Session Pooler IPv4 en puerto 5432 con sslmode=require):
# DATABASE_URL=postgresql://postgres.<project-ref>:change-me@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Se admite TALLERCLARO_DATABASE_URL por compatibilidad.
# Si ambas URLs existen en la misma fuente, gana DATABASE_URL.
# Las variables del proceso tienen prioridad sobre .env.
# Alternativa: configurar los campos individuales siguientes.
TALLERCLARO_DATABASE_HOST=localhost
TALLERCLARO_DATABASE_PORT=5432
TALLERCLARO_DATABASE_NAME=tallerclaro
TALLERCLARO_DATABASE_USER=tallerclaro_app
TALLERCLARO_DATABASE_PASSWORD=change-me
TALLERCLARO_DATABASE_SSL_MODE=prefer

TALLERCLARO_DATABASE_POOL_MIN_SIZE=2
TALLERCLARO_DATABASE_POOL_MAX_SIZE=10
# Tiempo máximo para adquirir una conexión del pool (segundos).
TALLERCLARO_DATABASE_POOL_ACQUIRE_TIMEOUT_SECONDS=10
# Caducidad de conexiones inactivas; el pool valida la conexión antes de entregarla.
TALLERCLARO_DATABASE_POOL_MAX_IDLE_SECONDS=300

# Proveedor de IA: none | openai | openrouter
TALLERCLARO_AI_PROVIDER=none
TALLERCLARO_AI_API_KEY=sk-change-me
TALLERCLARO_AI_MODEL=gpt-4o-mini
# TALLERCLARO_AI_BASE_URL=https://api.openai.com/v1

# Búsqueda de precios de materiales en vivo: none | channel3 | web
TALLERCLARO_PRICE_LOOKUP_PROVIDER=none
# TALLERCLARO_PRICE_LOOKUP_API_KEY=your-channel3-api-key
# TALLERCLARO_PRICE_LOOKUP_BASE_URL=https://api.trychannel3.com

# PayPal: none | sandbox | live
TALLERCLARO_PAYPAL_MODE=none
TALLERCLARO_PAYPAL_CLIENT_ID=change-me
TALLERCLARO_PAYPAL_CLIENT_SECRET=change-me
# TALLERCLARO_PAYPAL_BASE_URL se infiere del modo.
# TALLERCLARO_PAYPAL_RETURN_URL=https://example.org/#/customer/payment/return
# TALLERCLARO_PAYPAL_CANCEL_URL=https://example.org/#/customer/payment/cancel
# Verificación de webhooks (Sandbox): ID configurado en el panel de PayPal.
# TALLERCLARO_PAYPAL_WEBHOOK_ID=
# Live está fuera de este release; solo se habilita de forma explícita.
TALLERCLARO_ALLOW_LIVE_PAYMENTS=false

# Credenciales de demo del taller (el hash debe generarse con bcrypt en producción)
TALLERCLARO_WORKSHOP_USERNAME=taller
TALLERCLARO_WORKSHOP_PASSWORD_HASH=$2b$12$change-me

# Secreto para tokens de enlace de cliente (mínimo 32 caracteres)
TALLERCLARO_CUSTOMER_TOKEN_SECRET=change-me-secret-min-32-chars-long
TALLERCLARO_CUSTOMER_TOKEN_TTL_HOURS=72

# Orígenes permitidos para CORS (separados por coma o formato JSON; por defecto ["*"])
# TALLERCLARO_CORS_ORIGINS=http://localhost:5173,https://mitaller.com
