# Cabeceras de seguridad para Cloudflare Pages.
# La app no carga scripts, estilos ni fuentes externas; PayPal se abre por
# redirección completa (window.location), por lo que no necesita SDK ni iframes.
# connect-src permite https: porque el origen del backend se define en build
# con VITE_API_BASE_URL; restringirlo al dominio real cuando esté fijo.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), microphone=(self)

/assets/*
  Cache-Control: public, max-age=31536000, immutable

