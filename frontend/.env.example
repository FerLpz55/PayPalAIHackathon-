# Modo de la aplicación (se fija en tiempo de build; en Vercel van en
# Settings > Environment Variables y requieren un nuevo despliegue al cambiar).
#
# DEMO (datos de ejemplo en el navegador, sin backend ni PayPal):
#   VITE_APP_MODE=demo
#
# REAL (backend FastAPI desplegado; origen sin /api ni barra final):
#   VITE_APP_MODE=real
#   VITE_API_BASE_URL=https://api.tudominio.com
#
# Nunca pongas secretos aquí: todo VITE_* queda público en el bundle.
VITE_APP_MODE=demo
VITE_API_BASE_URL=
